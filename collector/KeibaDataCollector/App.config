<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      機密情報（利用キー、パスワード、ソフトウェアID等）はここに直接書かず、
      同名の環境変数で上書きしてください（AppConfig.cs が環境変数を優先して読みます）。
      ここに書いてよいのは非機密の既定値・雛形のみです。
    -->
    <add key="JvLinkProgId" value="JVDTLab.JVLink" />
    <!-- 実機のレジストリ(HKLM\SOFTWARE\Classes)で確認済み: NVDTLabLib.NVLink -->
    <add key="UmaConnProgId" value="NVDTLabLib.NVLink" />

    <add key="JvLinkSoftwareId" value="" />

    <add key="WordPressBaseUrl" value="https://keiba-tips.top" />
    <add key="WordPressUser" value="" />
    <add key="WordPressAppPassword" value="" />

    <add key="RealtimePollIntervalSeconds" value="20" />

    <!-- 6ファクター用の履歴DB。未指定ならbin配下の data\historical.sqlite3 を使う。 -->
    <add key="HistoricalDbPath" value="" />
  </appSettings>
</configuration>
