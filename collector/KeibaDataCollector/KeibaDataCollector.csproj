<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JV-Link / UmaConn はどちらも32bit専用のCOM(ActiveX)コンポーネントのため、
    PlatformTarget は必ず x86 にすること（AnyCPU/x64では実行時にCOM例外になる）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <RootNamespace>KeibaDataCollector</RootNamespace>
    <AssemblyName>KeibaDataCollector</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- 6ファクター用の履歴DB。x86ネイティブバイナリを同梱するため、上記のPlatformTarget=x86と噛み合う。 -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

</Project>
